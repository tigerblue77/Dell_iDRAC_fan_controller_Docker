{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./tests/run_tests.sh)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)"
    ]
  }
}
